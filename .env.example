# Copy to .env and fill in. The real .env lives ONLY on the box, never committed.

# OpenRouter
OPENROUTER_API_KEY=

# Telegram: create a bot via @BotFather, then run
#   TELEGRAM_BOT_TOKEN=xxx python scripts/get_telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free-tier daily request cap: 50 by default, 1000 if you've ever bought >= $10 credit.
AQR_DAILY_LIMIT=1000
AQR_DB_PATH=data/aqr.sqlite3
