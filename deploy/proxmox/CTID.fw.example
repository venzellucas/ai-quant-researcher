# Proxmox per-container firewall for the AI Quant Researcher.
#
# Install: copy to /etc/pve/firewall/<CTID>.fw on the Proxmox host (e.g. 105.fw),
# tick "Firewall" on the CT's network device, and make sure the Datacenter
# firewall is enabled. Rules live on the HOST, so the autonomous agent inside the
# container cannot read or edit them.
#
# Policy (defense in depth):
#   - egress to the INTERNET only (HTTPS/HTTP + DNS to public resolvers)
#   - NO east-west: cannot reach other containers/VMs or anything on the LAN
#   - cannot reach the Proxmox host management IP / API (8006) / SSH
#   - nothing on the network may initiate a connection TO it
#
# Order matters: first match wins. Private ranges are dropped BEFORE the
# internet ACCEPTs, so even :443 to another container is blocked.

[OPTIONS]
enable: 1
policy_in: DROP
policy_out: DROP
log_level_in: nolog
log_level_out: nolog

[RULES]
# 1) block all private space first (other guests, the host, the whole LAN)
OUT DROP -dest 10.0.0.0/8
OUT DROP -dest 172.16.0.0/12
OUT DROP -dest 192.168.0.0/16
OUT DROP -dest 100.64.0.0/10
OUT DROP -dest 169.254.0.0/16

# 2) then allow internet egress (these destinations are public by elimination)
OUT ACCEPT -p tcp -dport 443
OUT ACCEPT -p tcp -dport 80

# 3) DNS to PUBLIC resolvers only (NOT internal AdGuard -> that would be east-west)
OUT ACCEPT -dest 1.1.1.1 -p udp -dport 53
OUT ACCEPT -dest 1.0.0.1 -p udp -dport 53
OUT ACCEPT -dest 1.1.1.1 -p tcp -dport 53

# everything else falls through to policy_out DROP.
# (Optional admin SSH — uncomment and set your admin box IP if you want network
#  SSH instead of `pct enter`. This is a deliberate east-west exception.)
# IN ACCEPT -source 192.168.x.y -p tcp -dport 22
